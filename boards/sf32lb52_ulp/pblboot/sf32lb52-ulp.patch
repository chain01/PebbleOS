--- /dev/null
+++ b/boards/coredevices/sf32lb52_ulp/sf32lb52_ulp-pinctrl.dtsi
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026 Core Devices LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/dt-bindings/pinctrl/sf32lb52x-pinctrl.h>
+
