diff --git a/boot/Kconfig b/boot/Kconfig
index d8bac23..072886a 100644
--- a/boot/Kconfig
+++ b/boot/Kconfig
@@ -22,9 +22,25 @@ config PB_PRF_BUTTON_COMBO_TIME_MS
 	  Time in milliseconds that the PRF button combo must be held to trigger
 	  a PRF load.
 
+config PB_PRF_BUTTON_COMBO_TWO_BUTTONS
+	bool "Use Back+Select as the PRF button combo"
+	default n
+	help
+	  Use a two-button Back+Select combo instead of the default
+	  Back+Up+Center+Down combination.
+
+config PB_WATCHDOG
+	bool "Enable bootloader watchdog"
+	default y
+	help
+	  Initialize and feed the watchdog while the bootloader is running.
+	  Disable on targets where firmware must take ownership without a
+	  bootloader-configured watchdog still running.
+
 config PB_WATCHDOG_TIMEOUT_MS
 	int "Watchdog timeout (ms)"
 	default 10000
+	depends on PB_WATCHDOG
 	help
 	  Timeout in milliseconds for the watchdog timer.
 
