diff --git a/boot/boards/sf32lb52_ulp.overlay b/boot/boards/sf32lb52_ulp.overlay
new file mode 100644
index 0000000..e6e2569
--- /dev/null
+++ b/boot/boards/sf32lb52_ulp.overlay
@@ -0,0 +1,60 @@
+/*
+ * Copyright (c) 2026 Core Devices LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/ {
+	chosen {
+		/* we are the bootloader */
+		zephyr,code-partition = &boot;
+
+		/* slots */
+		pb,slot0 = &slot0;
+		pb,slot1 = &slot1;
+		pb,prf = &prf;
+
+		/* ULP has Back and Select only. Select acts as the center button. */
+		pb,btn-back = &key1;
+		pb,btn-center = &key2;
+
+		/* watchdog */
+		pb,wdt = &wdt;
+	};
+};
+
+&mpi2 {
+	flash@0 {
+		partitions {
+			/* define custom partition scheme */
+			/delete-node/ code@10000;
+
+			boot: partition@10000 {
+				label = "boot";
+				reg = <0x10000 DT_SIZE_K(64)>;
+			};
+
+			slot0: partition@20000 {
+				label = "slot0";
+				reg = <0x20000 DT_SIZE_K(3072)>;
+			};
+
+			slot1: partition@320000 {
+				label = "slot1";
+				reg = <0x320000 DT_SIZE_K(3072)>;
+			};
+
+			prf: partition@a20000 {
+				label = "prf";
+				reg = <0xa20000 DT_SIZE_K(512)>;
+			};
+		};
+	};
+};
+
+&wdt {
+	sifli,reset-all;
+};
+
+&usart1 {
+	current-speed = <1000000>;
+};
\ No newline at end of file
diff --git a/boot/src/buttons.c b/boot/src/buttons.c
index a32acd7..e4f713d 100644
--- a/boot/src/buttons.c
+++ b/boot/src/buttons.c
@@ -15,22 +15,32 @@
 LOG_MODULE_DECLARE(pblboot, CONFIG_PBLBOOT_LOG_LEVEL);
 
 static const struct gpio_dt_spec btn_back = GPIO_DT_SPEC_GET(DT_CHOSEN(pb_btn_back), gpios);
-static const struct gpio_dt_spec btn_up = GPIO_DT_SPEC_GET(DT_CHOSEN(pb_btn_up), gpios);
 static const struct gpio_dt_spec btn_center = GPIO_DT_SPEC_GET(DT_CHOSEN(pb_btn_center), gpios);
+
+#ifndef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
+static const struct gpio_dt_spec btn_up = GPIO_DT_SPEC_GET(DT_CHOSEN(pb_btn_up), gpios);
 static const struct gpio_dt_spec btn_down = GPIO_DT_SPEC_GET(DT_CHOSEN(pb_btn_down), gpios);
+#endif
 
 static inline bool buttons_prf_pressed(void)
 {
+#ifdef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
+	return (gpio_pin_get_dt(&btn_back) == 1) && (gpio_pin_get_dt(&btn_center) == 1);
+#else
 	return (gpio_pin_get_dt(&btn_back) == 1) && (gpio_pin_get_dt(&btn_up) == 1) &&
 	       (gpio_pin_get_dt(&btn_center) == 1) && (gpio_pin_get_dt(&btn_down) == 0);
+#endif
 }
 
 int pb_buttons_init(void)
 {
 	int ret;
 
-	if (!gpio_is_ready_dt(&btn_back) || !gpio_is_ready_dt(&btn_up) ||
-	    !gpio_is_ready_dt(&btn_center) || !gpio_is_ready_dt(&btn_down)) {
+	if (!gpio_is_ready_dt(&btn_back) || !gpio_is_ready_dt(&btn_center)
+#ifndef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
+	    || !gpio_is_ready_dt(&btn_up) || !gpio_is_ready_dt(&btn_down)
+#endif
+	   ) {
 		LOG_ERR("Button GPIO device/s not ready");
 		return -ENODEV;
 	}
@@ -41,11 +51,13 @@ int pb_buttons_init(void)
 		return ret;
 	}
 
+#ifndef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
 	ret = gpio_pin_configure_dt(&btn_up, GPIO_INPUT);
 	if (ret < 0) {
 		LOG_ERR("Failed to configure up button (err %d)", ret);
 		return ret;
 	}
+#endif
 
 	ret = gpio_pin_configure_dt(&btn_center, GPIO_INPUT);
 	if (ret < 0) {
@@ -53,11 +65,13 @@ int pb_buttons_init(void)
 		return ret;
 	}
 
+#ifndef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
 	ret = gpio_pin_configure_dt(&btn_down, GPIO_INPUT);
 	if (ret < 0) {
 		LOG_ERR("Failed to configure down button (err %d)", ret);
 		return ret;
 	}
+#endif
 
 	return 0;
 }
@@ -84,6 +98,9 @@ bool pb_buttons_prf_requested(void)
 
 bool pb_buttons_any_pressed(void)
 {
-	return (gpio_pin_get_dt(&btn_back) == 1) || (gpio_pin_get_dt(&btn_up) == 1) ||
-	       (gpio_pin_get_dt(&btn_center) == 1) || (gpio_pin_get_dt(&btn_down) == 1);
+	return (gpio_pin_get_dt(&btn_back) == 1) || (gpio_pin_get_dt(&btn_center) == 1)
+#ifndef CONFIG_PB_PRF_BUTTON_COMBO_TWO_BUTTONS
+	       || (gpio_pin_get_dt(&btn_up) == 1) || (gpio_pin_get_dt(&btn_down) == 1)
+#endif
+	       ;
 }
