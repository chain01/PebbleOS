diff --git a/boards/coredevices/sf32lb52_ulp/sf32lb52_ulp.dts b/boards/coredevices/sf32lb52_ulp/sf32lb52_ulp.dts
new file mode 100644
index 0000000..8cba369
--- /dev/null
+++ b/boards/coredevices/sf32lb52_ulp/sf32lb52_ulp.dts
@@ -0,0 +1,129 @@
+/*
+ * Copyright (c) 2026 Core Devices LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/dts-v1/;
+
+#include <sifli/sf32lb52x.dtsi>
+#include <sifli/sf32lb52x-ram012.dtsi>
+#include <zephyr/dt-bindings/dma/sf32lb52x-dma.h>
+#include <zephyr/dt-bindings/gpio/gpio.h>
+#include <zephyr/dt-bindings/input/input-event-codes.h>
+
+#include "sf32lb52_ulp-pinctrl.dtsi"
+
+/ {
+	model = "SiFli SF32LB52-LCHSPI-ULP";
+	compatible = "coredevices,sf32lb52-ulp";
+
+	chosen {
+		zephyr,flash = &xt25f128f;
+		zephyr,flash-controller = &mpi2;
+		zephyr,code-partition = &code;
+		zephyr,console = &usart1;
+		zephyr,shell-uart = &usart1;
+	};
+
+	buttons {
+		compatible = "gpio-keys";
+
+		key1: button-back {
+			label = "BACK";
+			gpios = <&gpioa_32_44 2 GPIO_ACTIVE_HIGH>;
+			zephyr,code = <INPUT_KEY_BACK>;
+		};
+
+		key2: button-select {
+			label = "SELECT";
+			gpios = <&gpioa_32_44 11 GPIO_ACTIVE_HIGH>;
+			zephyr,code = <INPUT_KEY_ENTER>;
+		};
+	};
+
+	aliases {
+		sw0 = &key1;
+		sw1 = &key2;
+		watchdog0 = &wdt;
+	};
+};
+
+&cpu0 {
+	clock-frequency = <DT_FREQ_M(240)>;
+};
+
+&hxt48 {
+	status = "okay";
+};
+
+&rcc_clk {
+	status = "okay";
+
+	sifli,hdiv = <1>;
+	sifli,pdiv1 = <1>;
+	sifli,pdiv2 = <6>;
+
+	dll1 {
+		status = "okay";
+		clock-frequency = <DT_FREQ_M(240)>;
+	};
+
+};
+
+&gpioa_00_31 {
+	status = "okay";
+};
+
+&gpioa_32_44 {
+	status = "okay";
+};
+
+&dmac {
+	status = "okay";
+};
+
+&mpi2 {
+	compatible = "sifli,sf32lb-mpi-qspi-nor";
+	dmas = <&dmac 0 SF32LB52X_DMA_REQ_MPI2 SF32LB_DMA_PL_MEDIUM>;
+	sifli,psclr = <0>;
+	sifli,lines = <4>;
+	status = "okay";
+
+	xt25f128f: flash@0 {
+		compatible = "jedec,qspi-nor";
+		reg = <0x0>;
+		size = <DT_SIZE_M(128)>;
+		quad-enable-requirements = "S2B1v1";
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			ptable: partition@0 {
+				label = "ptable";
+				reg = <0x0 DT_SIZE_K(64)>;
+			};
+
+			code: partition@10000 {
+				label = "code";
+				reg = <0x10000 DT_SIZE_K(16320)>;
+			};
+		};
+	};
+};
+
+&pinctrl {
+	status = "okay";
+};
+
+&usart1 {
+	status = "okay";
+	current-speed = <1000000>;
+	pinctrl-0 = <&usart1_default>;
+	pinctrl-names = "default";
+};
+
+&wdt {
+	status = "okay";
+};
\ No newline at end of file
