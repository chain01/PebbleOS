# sf32lb52-lchspi-ulp bring-up board configuration

CONFIG_SOC_SF32LB52=y
CONFIG_HAL_SIFLI_SF32LB52=y
CONFIG_HAL_SIFLI_EPIC=y
CONFIG_HAL_SIFLI_EZIP=y

CONFIG_PLATFORM_EMERY=y

CONFIG_SCREEN_COLOR_DEPTH_BITS_8=y

CONFIG_UART=y
CONFIG_I2C=y

CONFIG_DISPLAY=y
CONFIG_DISPLAY_CO5300_SF32LB=y
# CONFIG_DISPLAY_STUB is not set
# CONFIG_DISPLAY_JDI_SF32LB is not set

CONFIG_FLASH=y
CONFIG_FLASH_XT25F128F=y

CONFIG_OTP=y
CONFIG_OTP_FLASH=y

CONFIG_BATTERY=y
CONFIG_BATTERY_STUB=y

CONFIG_AMBIENT_LIGHT=y
CONFIG_AMBIENT_LIGHT_STUB=y

CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_STUB=y

CONFIG_VIBE=y
CONFIG_VIBE_STUB=y

CONFIG_ACCEL_STUB=y

CONFIG_TEMPERATURE=y
CONFIG_TEMPERATURE_SF32LB=y

CONFIG_WATCHDOG=y

CONFIG_EXTI=y

CONFIG_GPIO=y
CONFIG_TOUCH=y
CONFIG_TOUCH_FT6146=y

CONFIG_RTC=y

CONFIG_RNG=y

CONFIG_APP_SCALING=y

CONFIG_BRINGUP_NO_STORED_APPS=y

# Bring-up: emit plain-text logs on the debug UART. The hardware watchdog is
# enabled and fed through the normal task-watchdog path.
# CONFIG_PULSE_EVERYWHERE is not set
# CONFIG_NO_WATCHDOG is not set

# Bring-up: NimBLE uses the SF32LB52 LCPU controller.
CONFIG_BT_FW_NIMBLE=y
CONFIG_BT_LOG_LEVEL_DEBUG=y
# CONFIG_BT_FW_STUB is not set

# Bring-up diagnostics: full HCI tracing is disabled after the initial
# advertising/connection validation. Enable TRACE_LOG when debugging HCI.
CONFIG_NIMBLE_HCI_SF32LB52_TRACE_NONE=y
