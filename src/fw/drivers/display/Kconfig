menuconfig DISPLAY
    bool "Display"
    help
      Display Drivers

if DISPLAY

config DISPLAY_JDI_SF32LB
    bool "JDI (SiFli SF32LB)"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select HAL_SIFLI_LCD
    help
      Support for JDI display via SiFli SF32LB.

config DISPLAY_CO5300_SF32LB
    bool "CO5300 AMOLED (SiFli SF32LB QSPI)"
    select HAL_SIFLI
    select HAL_SIFLI_LCD
    help
      Support for the CO5300 AMOLED panel through the SiFli LCDC QSPI
      four-data interface.

config DISPLAY_SHARP_LS013B7DH01_NRF5
    bool "Sharp LS013B7DH01 (nRF5)"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Sharp LS013B7DH01 display via nRF5.

config DISPLAY_QEMU
    bool "QEMU Framebuffer Display"
    default y if SOC_QEMU
    help
      Support for the QEMU framebuffer display peripheral.

config DISPLAY_STUB
    bool "Stub display"
    help
      No-op display backend for board bring-up. The compositor and display
      services run normally, but no pixels are emitted.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
