menuconfig BATTERY
    bool "Battery"
    help
      Battery Drivers

if BATTERY

config BATTERY_PMIC
    bool "PMIC-based"
    help
      Battery management via external PMIC. Used on platforms where the
      PMIC handles battery monitoring (asterix, obelix, getafix).

config BATTERY_AW32001
    bool "AW32001 charger and battery ADC"
    depends on I2C
    depends on SOC_SF32LB52
    help
      AW32001 charger, USB/VBUS detection and battery voltage monitoring
      through the SiFli GPADC.

config BATTERY_QEMU
    bool "QEMU Battery"
    default y if SOC_QEMU
    help
      Stub battery driver for QEMU (fixed values).

config BATTERY_STUB
    bool "Stub"
    help
      Fixed-value battery driver for board bring-up.

module = DRIVER_BATTERY
module-str = Battery
source "subsys/logging/Kconfig.template.log_level"

endif # BATTERY
